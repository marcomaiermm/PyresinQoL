package-as: PyresinQoL
license-output: LICENSE

move-folders:
  PyresinQoL/PyresinQoL_ResourceBar: PyresinQoL_ResourceBar

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .stowrc
  - .codegraph
  - .github
  - .gitignore
  - .release
  - dist
  - docs
  - tests
  - tools
  - README.md
