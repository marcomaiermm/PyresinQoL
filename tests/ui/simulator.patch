diff --git a/src/lua_api/globals/template/direct_tests.rs b/src/lua_api/globals/template/direct_tests.rs
--- a/src/lua_api/globals/template/direct_tests.rs
+++ b/src/lua_api/globals/template/direct_tests.rs
@@ -66,3 +66,82 @@
         "explicit hidden=\"false\" must override an inherited hidden=true template"
     );
 }
+
+#[test]
+fn direct_xml_anchors_replace_inherited_anchor_set() {
+    fn direct_anchor(point: &str) -> AnchorXml {
+        AnchorXml {
+            point: Some(point.to_string()),
+            relative_to: Some("$parent".to_string()),
+            relative_key: None,
+            relative_point: Some(point.to_string()),
+            x: None,
+            y: None,
+            offset: None,
+        }
+    }
+
+    let state = Rc::new(RefCell::new(crate::lua_api::SimState::default()));
+    let (parent_id, child_id) = {
+        let mut state = state.borrow_mut();
+        let parent = crate::widget::Frame::new(
+            crate::widget::WidgetType::Frame,
+            Some("AnchorParent".to_string()),
+            None,
+        );
+        let parent_id = state.widgets.register(parent);
+        let child = crate::widget::Frame::new(
+            crate::widget::WidgetType::Frame,
+            Some("AnchorChild".to_string()),
+            Some(parent_id),
+        );
+        let child_id = state.widgets.register(child);
+        state.widgets.add_child(parent_id, child_id);
+        let child = state.widgets.get_mut_visual(child_id).unwrap();
+        child.set_point(
+            AnchorPoint::TopLeft,
+            Some(parent_id as usize),
+            AnchorPoint::TopLeft,
+            0.0,
+            0.0,
+        );
+        child.set_point(
+            AnchorPoint::BottomRight,
+            Some(parent_id as usize),
+            AnchorPoint::BottomRight,
+            0.0,
+            0.0,
+        );
+        (parent_id, child_id)
+    };
+
+    let direct = crate::xml::AnchorsXml {
+        anchors: vec![
+            direct_anchor("TOPLEFT"),
+            direct_anchor("BOTTOMLEFT"),
+            direct_anchor("RIGHT"),
+        ],
+    };
+    apply_xml_anchors(
+        &state,
+        child_id,
+        &FrameXml {
+            children: vec![crate::xml::FrameChildElement::Anchors(direct)],
+            ..FrameXml::default()
+        },
+        "",
+        "AnchorParent",
+    );
+
+    let state = state.borrow();
+    let child = state.widgets.get(child_id).unwrap();
+    assert_eq!(child.anchors.len(), 3);
+    assert!(child
+        .anchors
+        .iter()
+        .all(|anchor| anchor.point != AnchorPoint::BottomRight));
+    assert!(child
+        .anchors
+        .iter()
+        .all(|anchor| anchor.relative_to_id == Some(parent_id as usize)));
+}
