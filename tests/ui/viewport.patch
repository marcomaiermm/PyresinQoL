+++ b/src/bin/wow_sim/startup.rs
@@ -60,8 +60,20 @@ fn command_screen_size(command: &Option<Commands>) -> (f32, f32) {
         #[cfg(feature = "gui")]
         Some(Commands::Screenshot { width, height, .. }) => (*width as f32, *height as f32),
         Some(Commands::DumpTree { width, height, .. }) => (*width as f32, *height as f32),
-        None => (1024.0, 768.0),
-        _ => (1600.0, 1200.0),
+        _ => {
+            let size =
+                std::env::var("WOW_SIM_SCREEN_SIZE").unwrap_or_else(|_| "1920x1080".to_string());
+            let (width, height) = size
+                .split_once('x')
+                .expect("WOW_SIM_SCREEN_SIZE must be WIDTHxHEIGHT");
+            let width = width.parse::<u32>().expect("Invalid screen width");
+            let height = height.parse::<u32>().expect("Invalid screen height");
+            assert!(
+                width > 0 && height > 0,
+                "Screen dimensions must be positive"
+            );
+            (width as f32, height as f32)
+        }
     }
 }

